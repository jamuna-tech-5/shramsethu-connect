# ---- Supabase (required) ----
# Build-time (client) — must be set in Vercel BEFORE the build runs
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Runtime (server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI (document OCR/verification + translations) ----
# Use ONE of these. LOVABLE_API_KEY works inside Lovable; on other hosts use your own key.
LOVABLE_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ---- Admin dashboard ----
ADMIN_SECRET_CODE=SHRAMSETHU2026
SESSION_SECRET=

# ---- Google Maps (optional) ----
# Your own browser key (referrer-allowlist your production domain).
# If omitted, the app renders OpenStreetMap/Leaflet instead.
VITE_GOOGLE_MAPS_API_KEY=
# Your own server key for Places/Routes. If omitted, nearby search uses OpenStreetMap.
GOOGLE_MAPS_SERVER_KEY=
# Runtime browser Maps key fallback (used when VITE_GOOGLE_MAPS_API_KEY was not
# available at build time). Public key — must allow your Vercel domain as an
# HTTP referrer, with Maps JavaScript API enabled.
GOOGLE_MAPS_BROWSER_KEY_PUBLIC=
# Alternate name accepted for the same public browser key.
GOOGLE_MAPS_BROWSER_KEY=
